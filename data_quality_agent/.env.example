# 复制为 .env 后按需修改（.env 已被 .gitignore 忽略，不会提交）

# DeepSeek 大模型配置
DEEPSEEK_API_KEY=sk-你的密钥
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
MODEL_NAME=deepseek-v4-flash

# ReAct 循环限制（单次请求超时 60 秒，总时长 180 秒，可按需调整）
MAX_STEPS=8
LLM_REQUEST_TIMEOUT=60
MAX_TOTAL_TIME_SECONDS=180
MAX_HYPOTHESES_PER_STEP=3

# Embedding：auto=配置了 EMBEDDING_API_KEY 走 API，否则本地哈希嵌入（离线）
EMBEDDING_MODE=auto
# 嵌入服务密钥（与 DEEPSEEK_API_KEY 相互独立；DeepSeek 不提供嵌入接口）
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=https://api.deepseek.com/v1
EMBEDDING_MODEL=text-embedding-3-small

# 可选：验证 SQL 执行（默认关闭）
# SQL_EXECUTION_ENABLED=false
# DATA_DB_URL=sqlite:///./data/check.db
